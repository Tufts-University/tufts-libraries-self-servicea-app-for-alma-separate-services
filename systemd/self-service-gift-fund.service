[Unit]
Description=Self Service gift-fund
After=network.target
PartOf=self-service.target

[Service]
Type=simple
User=libraryapps
Group=libraryapps
WorkingDirectory=/var/www/html/self-service-app-encapsulated-v2
EnvironmentFile=-/etc/self-service-app/self-service.env
ExecStart=/opt/self-service-app-venv/bin/gunicorn -c /var/www/html/self-service-app-encapsulated-v2/gunicorn/component.conf.py --bind 127.0.0.1:5014 services.gift_fund_bibliography.wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=self-service.target
