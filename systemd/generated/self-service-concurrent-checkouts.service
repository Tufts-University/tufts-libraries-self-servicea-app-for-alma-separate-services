[Unit]
Description=Self Service concurrent-checkouts
After=network.target
PartOf=self-service.target

[Service]
Type=simple
User=libraryapps
Group=libraryapps
WorkingDirectory=/var/www/html/self-service-app-encapsulated-v2
EnvironmentFile=-/etc/self-service-app/self-service.env
ExecStart=/var/www/html/self-service-app-encapsulated-v2/.venv/bin/gunicorn -c /var/www/html/self-service-app-encapsulated-v2/gunicorn/component.conf.py --bind 127.0.0.1:5016 services.concurrent_checkouts.wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=self-service.target
