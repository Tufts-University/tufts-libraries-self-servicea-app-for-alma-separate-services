[Unit]
Description=Self Service Gateway
After=network.target
PartOf=self-service.target

[Service]
Type=simple
User=libraryapps
Group=libraryapps
WorkingDirectory=/var/www/html/self-service-app-encapsulated-v2
EnvironmentFile=-/etc/self-service-app/self-service.env
ExecStart=/var/www/html/self-service-app-encapsulated-v2/.venv/bin/gunicorn -c /var/www/html/self-service-app-encapsulated-v2/gunicorn/gateway.conf.py --bind 127.0.0.1:5002 gateway_wsgi:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=self-service.target
