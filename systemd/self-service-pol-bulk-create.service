[Unit]
Description=Self Service pol-bulk-create
After=network.target rqworker-polBulkCreate.service
PartOf=self-service.target
Requires=rqworker-polBulkCreate.service

[Service]
Type=simple
User=libraryapps
Group=libraryapps
WorkingDirectory=/var/www/html/self-service-app-encapsulated-v2
EnvironmentFile=-/etc/self-service-app/self-service.env
ExecStart=/opt/self-service-app-venv/bin/gunicorn -c /var/www/html/self-service-app-encapsulated-v2/gunicorn/component.conf.py --bind 127.0.0.1:5018 services.bulk_create_pol.wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=self-service.target
